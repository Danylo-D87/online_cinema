# Database settings
DATABASE_URL="sqlite+aiosqlite:///./sql_online_cinema.db"

# Security settings
SECRET_KEY="your_super_secret_key_for_jwt_development"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email settings (for activation, password reset)
EMAIL_HOST_USER="your_email@example.com"
EMAIL_HOST_PASSWORD="your_email_password"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Environment
ENVIRONMENT="development"